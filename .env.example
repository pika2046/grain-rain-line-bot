# 穀雨 LINE AI 店員 — 環境變數範本
# 複製為 .env（或直接設在 Zeabur / Render 的環境變數），填入真實值。絕不上傳到公開處。

# LINE Developers 後台 → Messaging API 分頁
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LLM（OpenAI 相容 API；免費可用 Google AI Studio 的 Gemini API key）
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# 伺服器
PORT=3000
