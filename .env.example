# 穀雨 LINE AI 店員 — 環境變數範本
# 複製為 .env（或直接設在 Zeabur / Render 的環境變數），填入真實值。絕不上傳到公開處。

# LINE Developers 後台 → Messaging API 分頁
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LLM（OpenAI 相容 API；Google AI Studio 的 Gemini API，付費預付點數制）
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

# 老闆私人 LINE 的 userId（U 開頭）：訂單確認後推播通知用，不設則只寫 log
BOSS_USER_ID=

# 客人檔案（Google 試算表）：沒設則客人檔案功能自動停用，不影響回覆
GOOGLE_SHEETS_KEY={"type":"service_account", "...": "service account JSON 金鑰全文"}
SHEET_ID=試算表網址 /d/ 與 /edit 之間的 ID

# 伺服器
PORT=3000
